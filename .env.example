DAYTONA_API_KEY=
NOSANA_API_KEY=
# Optional: your own Nosana deployment (OpenAI-compatible), e.g. https://<job>.node.k8s.prd.nos.ci/v1
NOSANA_BASE_URL=
# Model id exactly as <base>/models lists it, e.g. glm-4.7-flash:q4_K_M
NOSANA_MODEL=
# Optional: auth for that deployment only; NOSANA_API_KEY is never sent to it
NOSANA_ENDPOINT_KEY=
